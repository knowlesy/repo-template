# EditorConfig helps developers define and maintain consistent coding styles
# between different editors and IDEs.
# https://editorconfig.org
#
# VS Code: install the "EditorConfig for VS Code" extension (EditorConfig.EditorConfig)
# — it is listed in .vscode/extensions.json and VS Code will prompt you to install it.

root = true

# ==========================================
# Global Defaults
# ==========================================
[*]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ==========================================
# Python — PEP 8
# ==========================================
[*.py]
indent_size = 4
end_of_line = lf

# ==========================================
# YAML, Helm, and ArgoCD
# ==========================================
[*.{yaml,yml}]
# Kubernetes and Helm require strictly 2-space indentation
indent_size = 2

# ==========================================
# Terraform / HCL — HashiCorp standard
# ==========================================
[*.{tf,tfvars,hcl}]
indent_size = 2
end_of_line = lf

# ==========================================
# Puppet — Puppet style guide
# ==========================================
[*.pp]
indent_size = 2
end_of_line = lf

# ==========================================
# Ruby (used by Puppet: Gemfile, Rakefile)
# ==========================================
[*.{rb,Gemfile,Rakefile,Puppetfile}]
indent_size = 2
end_of_line = lf

# ==========================================
# Shell scripts
# ==========================================
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# ==========================================
# PowerShell — Windows native CRLF
# ==========================================
[*.{ps1,psm1,psd1}]
# PowerShell scripts run natively on Windows and expect CRLF line endings
end_of_line = crlf
indent_size = 4

# ==========================================
# JSON
# ==========================================
[*.json]
indent_size = 2

# ==========================================
# Markdown
# ==========================================
[*.md]
# Markdown uses two trailing spaces for line breaks — do not trim them
trim_trailing_whitespace = false
indent_size = 2

# ==========================================
# Makefile — tabs required
# ==========================================
[Makefile]
indent_style = tab
