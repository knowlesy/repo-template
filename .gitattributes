# Enforce consistent line endings across platforms.
# LF (Unix) everywhere except PowerShell which must run natively on Windows.

# ── Core languages ──────────────────────────────────────────────────────────
*.py        text eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.sh        text eol=lf
*.bash      text eol=lf

# ── Config / data formats ────────────────────────────────────────────────────
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf

# ── Terraform / HCL ─────────────────────────────────────────────────────────
*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf

# ── Ansible ──────────────────────────────────────────────────────────────────
*.j2        text eol=lf

# ── Puppet / Ruby ────────────────────────────────────────────────────────────
*.pp        text eol=lf
*.rb        text eol=lf
Gemfile     text eol=lf
Rakefile    text eol=lf
Puppetfile  text eol=lf

# ── Helm / Kubernetes ────────────────────────────────────────────────────────
*.tpl       text eol=lf

# ── Documentation / text ─────────────────────────────────────────────────────
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.xml       text eol=lf

# ── Binary — never diff or mangle ────────────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.zip       binary
*.tgz       binary
*.tar       binary
*.gz        binary
*.pfx       binary
*.p12       binary
