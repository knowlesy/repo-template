# ==============================================================================
# 1. CORE SECURITY, KEYS, & CERTS (Must align across .gitignore, .dockerignore, etc.)
# ==============================================================================
*.pem
*.key
*.crt
*.cert
*.pfx
*.csr
.env*
secrets/
certs/

# ==============================================================================
# 2. PYTHON 
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing / Type checking caches
.pytest_cache/
.tox/
.nox/
.coverage
.cache
htmlcov/
.mypy_cache/
.pyre/
.ruff_cache/

# ==============================================================================
# 3. POWERSHELL
# ==============================================================================
# PowerShell XML serialization files and execution logs
.ps1[^1]
*.log
*.clixml
modules/

# ==============================================================================
# 4. HELM & ARGOCD
# ==============================================================================
# Ignore fetched dependencies (always let `helm dependency update` fetch them fresh)
charts/
*.tgz

# Ignore locally rendered manifests or tool-specific output data
my-values.yaml
.argocd-source-*.yaml
manifests/
extracted-charts/

# ==============================================================================
# 5. TERRAFORM
# OPTIONAL — Remove this section if your project does not use Terraform
# ==============================================================================
# Local .terraform directory (provider plugins + modules — always regenerated)
.terraform/
.terraform.lock.hcl

# Terraform state files (contain sensitive infrastructure data)
*.tfstate
*.tfstate.backup
*.tfstate.d/

# Override files (local developer overrides, never commit)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files (use *.tfvars.example for checked-in examples)
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# ==============================================================================
# 6. ANSIBLE
# OPTIONAL — Remove this section if your project does not use Ansible
# ==============================================================================
# Retry files created by ansible-playbook on failure
*.retry

# Vault password files (NEVER commit these)
vault_pass*
.vault_pass
*.vault_password

# Ansible Galaxy roles fetched at runtime (should be in requirements.yml)
roles/vendor/

# ==============================================================================
# 7. PUPPET
# OPTIONAL — Remove this section if your project does not use Puppet
# ==============================================================================
# Module build artifacts (generated by puppet module build)
pkg/

# Bundler / Gemfile artifacts
.bundle/
vendor/bundle
Gemfile.lock

# Test fixtures fetched by puppetlabs_spec_helper
spec/fixtures/

# Vagrant VMs used for acceptance testing
.vagrant/

# Librarian-puppet fetched modules
.librarian/
Puppetfile.lock

# ==============================================================================
# 8. DOCKER & CONTAINER LOCAL ARTIFACTS
# OPTIONAL — Remove this section if your project does not use Docker
# ==============================================================================
# Prevent tracking local container state or build dumps
docker-compose.override.yml

# ==============================================================================
# 9. SYSTEM & IDE CLUTTER
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# Windows NTFS alternate data streams (appear in WSL-mounted directories)
*Zone.Identifier

# IDE - VS Code / Cursor (keep extensions.json and settings.json committed)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/
*.code-workspace

# IDE - EditorConfig local overrides (if any)
.editorconfig.local
