# GitHub Copilot context guardrails.
#
# This file is intentionally kept identical to .aiignore — update both together.
# Other AI tools (Claude, ChatGPT, Gemini Code Assist) use .aiignore directly.
#
# Goal: keep secrets out of Copilot context and avoid wasting suggestions on
# generated artefacts that don't represent source-of-truth code.

# === SECRETS & CREDENTIALS ===
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.csr
.env*
secrets/
certs/

# === TERRAFORM ===
# State files contain sensitive infrastructure data (IPs, passwords, etc.)
*.tfstate
*.tfstate.backup
*.tfstate.d/
# Provider plugins — large binaries, not source code
.terraform/
# Sensitive variable files
*.tfvars
!*.tfvars.example

# === ANSIBLE ===
# Vault password files
vault_pass*
.vault_pass
*.vault_password
# Retry files
*.retry

# === PUPPET ===
# Vendor/bundle — large fetched dependencies
vendor/bundle
.bundle/
spec/fixtures/

# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# === POWERSHELL ===
.ps1[^1]
*.log
*.clixml

# === HELM & ARGO ===
charts/
*.tgz
my-values.yaml
.argocd-source-*.yaml
